{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "attributes": {
    "order_number": {
      "type": "string",
      "unique": true
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "accepted",
        "preparing",
        "served",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "unpaid",
        "paid"
      ],
      "default": "unpaid"
    },
    "subtotal": {
      "type": "decimal"
    },
    "service_charge": {
      "type": "decimal"
    },
    "total": {
      "type": "decimal"
    },
    "notes": {
      "type": "text"
    },
    "customer_session_id": {
      "type": "string"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "order.order-item"
    },
    "table": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::table.table"
    },
    "business": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::business.business"
    },
    "waiter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::employee.employee"
    }
  }
}