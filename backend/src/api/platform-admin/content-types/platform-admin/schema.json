{
  "kind": "collectionType",
  "collectionName": "platform_admins",
  "info": {
    "singularName": "platform-admin",
    "pluralName": "platform-admins",
    "displayName": "Platform Admin"
  },
  "attributes": {
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "role": {
      "type": "string",
      "default": "platform_master"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "android_app_link": {
      "type": "string"
    },
    "ios_app_link": {
      "type": "string"
    },
    "waiter_call_delay": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 1440
    },
    "request_bill_delay": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 1440
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}